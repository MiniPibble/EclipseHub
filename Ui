		Font = Enum.Font.Code,
		TextXAlignment = Left,
		TextWrapped = true,
		LayoutOrder = logCount,
		Parent = LogScroll,
	})
	logLines[#logLines + 1] = line
	if #logLines > 80 then
		local first = table.remove(logLines, 1)
		first:Destroy()
	end
	task.delay(0.03, function()
		if LogScroll and LogScroll.Parent then
			LogScroll.CanvasPosition = Vector2.new(0, 1e6)
		end
	end)
end

